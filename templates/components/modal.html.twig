{# templates/components/modal.html.twig #}
{# Parámetros esperados: modalId (string), title (string) #}
	<div id="{{ modalId }}" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center
				           opacity-0 pointer-events-none transition duration-300 ease-out" style="z-index:999"> <div class="bg-white rounded-lg overflow-hidden w-2/3 max-w-xl transform transition duration-300 ease-out">
		<header class="px-6 py-4 border-b relative">
			<h2 class="text-lg font-semibold">{{ title }}</h2>
			<button data-close class="absolute top-3 right-3 text-gray-500 hover:text-gray-800">×</button>
		</header>

		<section class="p-6"> {% block modal_body %}{% endblock %}
			</section>

			<footer class="px-6 py-4 bg-gray-100 text-right">
				{% block modal_footer %}
					<button data-close class="text-white bg-gradient-to-r from-gray-400 via-gray-500 to-gray-600 hover:bg-gradient-to-br focus:ring-2 focus:outline-none focus:ring-gray-300 dark:focus:ring-gray-800 font-medium rounded-lg text-sm px-5 py-2.5 text-center">Cerrar</button>
				{% endblock %}
			</footer>
		</div>
	</div>

	<script>
		document.addEventListener('DOMContentLoaded', () => { // Abrir modal
document.querySelectorAll('[data-open]').forEach(btn => {
btn.addEventListener('click', () => {
const modal = document.getElementById(btn.dataset.open);
modal.classList.remove('opacity-0', 'pointer-events-none');
modal.classList.add('opacity-100', 'pointer-events-auto');
});
});

// Cerrar modal con botones
document.querySelectorAll('[data-close]').forEach(btn => {
btn.addEventListener('click', () => {
const modal = btn.closest('div[id]');
modal.classList.add('opacity-0', 'pointer-events-none');
modal.classList.remove('opacity-100', 'pointer-events-auto');
});
});

// Cerrar al click en el overlay (fondo)
document.querySelectorAll('.fixed.inset-0.bg-black').forEach(overlay => {
overlay.addEventListener('click', e => {
if (e.target === overlay) {
overlay.classList.add('opacity-0', 'pointer-events-none');
overlay.classList.remove('opacity-100', 'pointer-events-auto');
}
});
});
});
	</script>
