{% extends 'base.html.twig' %}

{% block title %}
	Messages
{% endblock %}

{% block body %}
	<div class="m-4 p-4 relative overflow-x-auto shadow-md sm:rounded-lg">
		<div>
			<h1 class="text-2xl font-bold p-4">{{ message.contact.name }}</h1>
			<span class="text-gray-500 text-sm p-4">
				Creado: {{ message.created_at|date('d/m/Y H:i') }}
			</span>
			
			<p class="text-gray-500 mt-4 p-4">
				{% if message.body_type == 'IMAGE' %}
					<img src="https://s3.eu-central-1.amazonaws.com/trengo/media/{{ message.file_name }}" alt="Imagen" class="w-full h-auto object-cover rounded-lg"/>
				{% else %}
					{{ message.message|split('@import')|first|trim }}
				{% endif %}
			</p>
		</div>
	</div>
{% endblock %}
